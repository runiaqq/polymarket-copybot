# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-main-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-random-string
ADMIN_TELEGRAM_ID=your-telegram-id

# Optional second bot for admins (subscription management). Leave blank to disable.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_WEBHOOK_SECRET=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# ── Privy (legacy, not used) ──────────────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Polymarket ────────────────────────────────────────────────────────────────
POLYMARKET_CHAIN_ID=137
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/trade
POLYMARKET_CLOB_REST_URL=https://clob.polymarket.com

# ── Alchemy (Polygon RPC) ─────────────────────────────────────────────────────
ALCHEMY_API_KEY=your-alchemy-key
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-alchemy-key

# ── Wallet encryption (REQUIRED) ──────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: store securely + back up offline. Losing this key = losing access to ALL user wallets.
ENCRYPTION_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
WEBHOOK_BASE_URL=https://your-railway-domain.up.railway.app

# ── Strategy: whale-tracking on fast markets ──────────────────────────────────
# Market universe (watched over WebSocket)
MARKET_MAX_HOURS_TO_RESOLVE=48
MARKET_MIN_HOURS_TO_RESOLVE=0.5          # skip ultra-fast 5-15min crypto (thin, HFT)
MARKET_MIN_LIQUIDITY_USDC=1000.0
WATCH_MAX_MARKETS=300
FAST_MARKETS_REFRESH_SEC=120
MARKET_SIGNAL_COOLDOWN_SEC=600

# Dynamic "large buy" detection (liquidity/volume relative)
DYN_ABS_FLOOR_USDC=100.0                 # never signal below this absolute size
DYN_REL_DEPTH=0.5                        # trade >= 50% of fillable ask depth
DYN_REL_VOL=3.0                          # trade >= 3x recent p90 trade size
RECENT_TRADE_WINDOW_SEC=600
RECENT_TRADE_MIN_SAMPLES=5

# Break-even guards
MAX_SPREAD_PCT=0.03
MAX_ENTRY_PRICE=0.95
MIN_ENTRY_PRICE=0.05
FEE_BPS_MAX=500.0
DYN_MIN_BOOK_DEPTH_USDC=50.0

# Copy sizing
COPY_SCALE=1.0
BOOK_SAFE_FRAC=0.25                      # take at most 25% of fillable depth
ORDER_SLIPPAGE_PCT=0.02

# WebSocket (real-time market data)
WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
WS_HEARTBEAT_SEC=10
WS_REFRESH_MARKETS_SEC=120

# Exits / position management (Phase 3)
TP_SL_MIN_HOURS=6.0          # apply TP/SL only when >= this many hours to resolve
TAKE_PROFIT_PCT=0.25         # +25% -> take profit
STOP_LOSS_PCT=0.40           # -40% -> stop loss
EXIT_SLIPPAGE_PCT=0.03
MAX_OPEN_POSITIONS=10
POSITIONS_SYNC_SEC=60
SETTLEMENT_LOOKBACK_SEC=7200   # only notify win/loss for settlements newer than this
AUTO_REDEEM_ENABLED=false     # on-chain redeem after resolve — verify V2/pUSD flow first

# ── Legacy donor-copy / REST-scan knobs (optional) ────────────────────────────
WHALE_MIN_USDC=5000.0
SCAN_TRADES_LIMIT=100
MIN_TRADE_SIZE_USDC=50.0
MIN_MARKET_HOURS_TO_CLOSE=48

# ── AI ────────────────────────────────────────────────────────────────────────
AI_RISK_WARN_THRESHOLD=7
AI_BLOCK_ENABLED=false
